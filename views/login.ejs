<%- include('partials/header') %>

<div class="auth-wrap">
  <div class="auth-card" data-fade>
    <h1 class="auth-title" style="display:flex; align-items:center; justify-content:center; gap:10px;">
      <svg class="ui-icon" style="width:24px; height:24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
        <polyline points="10 17 15 12 10 7"></polyline>
        <line x1="15" y1="12" x2="3" y2="12"></line>
      </svg>
      <span>Вход в аккаунт</span>
    </h1>
    <p class="auth-subtitle">Войдите, чтобы сохранять сборки и оставлять отзывы</p>

    <% if (typeof successMsg !== 'undefined' && successMsg) { %>
      <div style="background:rgba(0,230,118,0.12); border:1px solid rgba(0,230,118,0.35); border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:20px; color:var(--success); font-size:14px;">
        <%= successMsg %>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:rgba(255,23,68,0.12); border:1px solid rgba(255,23,68,0.3); border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:20px; color:var(--danger); font-size:14px; display:flex; align-items:center; gap:8px;">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST" data-validate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <input type="email" id="email" name="email" class="form-input" placeholder="user@example.com" required autocomplete="email">
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Пароль</label>
        <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" required autocomplete="current-password">
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:8px;">Войти</button>
    </form>

    <div class="auth-divider">или</div>

    <div style="display:flex; gap:12px;">
      <a href="/register" class="btn btn-secondary btn-block">Регистрация</a>
      <a href="/forgot-password" class="btn btn-ghost btn-block">Забыли пароль?</a>
    </div>

    <div class="auth-footer">
      Входя в аккаунт, вы принимаете <a href="/privacy">политику конфиденциальности</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
