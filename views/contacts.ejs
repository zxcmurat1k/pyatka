<%- include('partials/header') %>

<h1 class="page-title">Контакты</h1>
<p class="page-subtitle">Свяжитесь с нами — мы всегда на связи</p>

<% if (typeof sent !== "undefined" && sent) { %>
  <div style="max-width:1000px; margin:0 auto 24px; padding:14px 20px; border-radius:var(--radius-sm); background:rgba(0,230,118,0.12); border:1px solid rgba(0,230,118,0.35); color:var(--success); font-weight:500;">
    Сообщение успешно отправлено! Мы ответим вам в ближайшее время.
  </div>
<% } %>

<div class="contacts-layout">
  <!-- Contact Info -->
  <div class="contacts-info" data-fade>
    <div class="contact-card">
      <div class="contact-card-icon">
        <svg class="ui-icon" style="width:24px; height:24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
      </div>
      <div>
        <div class="contact-card-title">Email</div>
        <div class="contact-card-text">support@hornyho.com</div>
      </div>
    </div>

    <div class="contact-card">
      <div class="contact-card-icon">
        <svg class="ui-icon" style="width:24px; height:24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
      </div>
      <div>
        <div class="contact-card-title">Discord</div>
        <div class="contact-card-text">discord.gg/hornyho</div>
      </div>
    </div>

    <div class="contact-card">
      <div class="contact-card-icon">
        <svg class="ui-icon" style="width:24px; height:24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </div>
      <div>
        <div class="contact-card-title">Telegram</div>
        <div class="contact-card-text">@hornyho_mods</div>
      </div>
    </div>

    <div class="contact-card">
      <div class="contact-card-icon">
        <svg class="ui-icon" style="width:24px; height:24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <div>
        <div class="contact-card-title">Время ответа</div>
        <div class="contact-card-text">Обычно в течение 24 часов</div>
      </div>
    </div>
  </div>

  <!-- Contact Form -->
  <div data-fade>
    <div class="card" style="padding:32px;">
      <h3 style="font-size:1.3rem; margin-bottom:24px; display:flex; align-items:center; gap:10px;">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>Написать нам</span>
      </h3>

      <form action="/contacts" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="name">Имя</label>
          <input type="text" id="name" name="name" class="form-input" placeholder="Ваше имя" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input type="email" id="email" name="email" class="form-input" placeholder="user@example.com" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="subject">Тема</label>
          <input type="text" id="subject" name="subject" class="form-input" placeholder="О чём хотите написать?" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="message">Сообщение</label>
          <textarea id="message" name="message" class="form-textarea" placeholder="Опишите ваш вопрос или предложение..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg btn-pill">
          <svg class="ui-icon ui-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
          <span>Отправить</span>
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
