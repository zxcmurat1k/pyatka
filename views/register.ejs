<%- include('partials/header') %>

<%
  var curStep = typeof step !== 'undefined' ? step : 'form';
  var f = typeof formData !== 'undefined' && formData ? formData : {};
%>

<div class="auth-wrap">
  <div class="auth-card" data-fade>
    <h1 class="auth-title" style="display:flex; align-items:center; justify-content:center; gap:10px;">
      <svg class="ui-icon" style="width:24px; height:24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="8.5" cy="7" r="4"></circle>
        <line x1="20" y1="8" x2="20" y2="14"></line>
        <line x1="23" y1="11" x2="17" y2="11"></line>
      </svg>
      <span><%= curStep === 'verify' ? 'Подтверждение почты' : 'Регистрация' %></span>
    </h1>
    <p class="auth-subtitle">
      <% if (curStep === 'verify') { %>
        Введите 6-значный код, отправленный на <strong><%= f.email || '' %></strong>
      <% } else { %>
        Создайте аккаунт HornyHo, чтобы собирать модпаки и оставлять отзывы
      <% } %>
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:rgba(255,23,68,0.12); border:1px solid rgba(255,23,68,0.3); border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:20px; color:var(--danger); font-size:14px;">
        <%= error %>
      </div>
    <% } %>

    <% if (typeof info !== 'undefined' && info) { %>
      <div style="background:rgba(56,189,248,0.12); border:1px solid rgba(56,189,248,0.35); border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:20px; color:var(--accent-primary); font-size:14px;">
        <%= info %>
      </div>
    <% } %>

    <% if (typeof devCode !== 'undefined' && devCode) { %>
      <div style="background:rgba(255,171,0,0.12); border:1px solid rgba(255,171,0,0.4); border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:20px; color:var(--warning); font-size:13.5px;">
        <strong>Тестовый режим (SMTP пока не настроен):</strong><br>
        Код подтверждения: <code style="font-size:16px; font-weight:800; letter-spacing:3px; color:var(--text-main);"><%= devCode %></code>
      </div>
    <% } %>

    <% if (curStep === 'verify') { %>
      <form action="/register/verify" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="email" value="<%= f.email || '' %>">

        <div class="form-group">
          <label class="form-label" for="code">6-значный код из письма</label>
          <input type="text" id="code" name="code" class="form-input" placeholder="000000" required maxlength="6" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" style="text-align:center; font-size:22px; letter-spacing:8px; font-weight:700;">
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">Подтвердить и создать аккаунт</button>
      </form>

      <div style="margin-top:16px; text-align:center;">
        <a href="/register" class="btn btn-ghost btn-sm">Изменить почту или отправить код заново</a>
      </div>
    <% } else { %>
      <form action="/register" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="name">Никнейм / Имя</label>
          <input type="text" id="name" name="name" class="form-input" placeholder="PlayerOne" value="<%= f.name || '' %>" required minlength="2">
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input type="email" id="email" name="email" class="form-input" placeholder="user@example.com" value="<%= f.email || '' %>" required autocomplete="email">
        </div>

        <div class="form-group">
          <label class="form-label" for="phone">Телефон (опционально)</label>
          <input type="text" id="phone" name="phone" class="form-input" placeholder="+7 (999) 000-00-00" value="<%= f.phone || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="password">Пароль (от 6 символов)</label>
          <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" required minlength="6" autocomplete="new-password">
        </div>

        <div class="form-group">
          <label class="form-label" for="password_confirm">Повторите пароль</label>
          <input type="password" id="password_confirm" name="password_confirm" class="form-input" placeholder="••••••••" required minlength="6" autocomplete="new-password">
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">Отправить код на почту</button>
      </form>
    <% } %>

    <div class="auth-divider">уже есть аккаунт?</div>
    <a href="/login" class="btn btn-secondary btn-block">Войти</a>
  </div>
</div>

<%- include('partials/footer') %>
