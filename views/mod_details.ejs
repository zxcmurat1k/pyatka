<%- include('partials/header') %>

<%
  var stepsRaw = mod.install_instructions || '';
  var steps = stepsRaw.split(/\\n|\n/).filter(function(s) { return s.trim(); });
  steps = steps.map(function(s) { return s.replace(/^\d+[\.\)]\s*/, '').trim(); });
%>

<div style="margin-bottom:20px;">
  <a href="/catalog" class="btn btn-ghost btn-sm">
    <svg class="ui-icon ui-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    <span>Назад в каталог</span>
  </a>
</div>

<div class="mod-detail-layout">
  <!-- LEFT: Mod Content -->
  <div>
    <% if (mod.image_url) { %>
      <div class="mod-card-media<%= mod.is_nsfw ? ' nsfw-media' : '' %>" style="border-radius:var(--radius); border:1px solid var(--border-subtle); aspect-ratio:16/9;">
        <img src="<%= mod.image_url %>" alt="<%= mod.title %>" class="card-img" loading="lazy">
        <% if (mod.is_nsfw) { %>
          <div class="nsfw-badge-overlay" title="Нажмите, чтобы показать">
            <span class="nsfw-badge-pill">
              <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
              <span>18+ • Скрыто</span>
            </span>
          </div>
        <% } %>
      </div>
    <% } %>

    <div style="margin-top:24px;">
      <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap; align-items:center;">
        <span class="badge badge-game"><%= mod.game_title %></span>
        <% if (mod.cat_name) { %><span class="badge badge-cat"><%= mod.cat_name %></span><% } %>
        <% if (mod.game_version) { %><span class="badge" style="background:var(--bg-elevated); color:var(--text-muted); border:1px solid var(--border-subtle);">v<%= mod.game_version %></span><% } %>
        <% if (mod.is_nsfw) { %><span class="badge badge-nsfw">18+</span><% } %>
      </div>

      <h1 class="page-title"><%= mod.title %></h1>

      <div style="color:var(--text-muted); font-size:15px; line-height:1.7; margin-top:16px; margin-bottom:32px;">
        <%= mod.description %>
      </div>

      <!-- Install Instructions -->
      <h2 style="font-size:1.35rem; margin-bottom:16px; display:flex; align-items:center; gap:10px;">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <span>Инструкция по установке</span>
      </h2>

      <% if (steps.length > 0) { %>
        <ol class="install-steps">
          <% steps.forEach(function(step) { %>
            <li class="install-step">
              <span class="install-step-text"><%= step %></span>
            </li>
          <% }); %>
        </ol>
      <% } else { %>
        <p style="color:var(--text-muted);">Инструкция не указана.</p>
      <% } %>

      <!-- Source URL -->
      <% if (mod.source_url) { %>
        <div style="margin-top:28px;">
          <a href="<%= mod.source_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill">
            <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            <span>Скачать / Перейти к источнику</span>
          </a>
        </div>
      <% } %>

      <!-- Reviews -->
      <section class="reviews-section">
        <h2 style="font-size:1.35rem; margin-bottom:20px; display:flex; align-items:center; gap:10px;">
          <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Отзывы (<%= typeof reviews !== 'undefined' ? reviews.length : 0 %>)</span>
        </h2>
        <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
          <% reviews.forEach(function(r) { %>
            <div class="review-card" data-fade>
              <div class="review-header">
                <div class="review-avatar">
                  <%= (r.user_name || 'Пользователь').charAt(0).toUpperCase() %>
                </div>
                <div>
                  <div class="review-author"><%= r.user_name || 'Пользователь' %></div>
                  <div class="review-date" style="font-size:12px; color:var(--text-dim);"><%= r.created_at || '' %></div>
                </div>
                <div class="review-stars" style="margin-left:auto; display:flex; gap:2px;">
                  <% for (var s = 0; s < 5; s++) { %>
                    <% if (s < r.rating) { %>
                      <svg class="star-icon filled" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                    <% } else { %>
                      <svg class="star-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                      </svg>
                    <% } %>
                  <% } %>
                </div>
              </div>
              <div class="review-text"><%= r.comment %></div>
            </div>
          <% }); %>
        <% } else { %>
          <p style="color:var(--text-muted);">Пока нет отзывов. Будьте первым!</p>
        <% } %>
      </section>

      <!-- Related Mods -->
      <% if (typeof relatedMods !== 'undefined' && relatedMods && relatedMods.length > 0) { %>
        <section style="margin-top:48px;">
          <h2 style="font-size:1.35rem; margin-bottom:20px; display:flex; align-items:center; gap:10px;">
            <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="6"></circle>
              <circle cx="12" cy="12" r="2"></circle>
            </svg>
            <span>Похожие моды</span>
          </h2>
          <div class="catalog-grid">
            <% relatedMods.forEach(function(rm) { %>
              <a href="/mods/<%= rm.id %>" class="mod-card" style="text-decoration:none; color:inherit;">
                <div class="mod-card-media">
                  <% if (rm.image_url) { %>
                    <img src="<%= rm.image_url %>" alt="<%= rm.title %>" class="card-img" loading="lazy">
                  <% } %>
                </div>
                <div class="mod-card-body">
                  <div class="mod-card-title"><%= rm.title %></div>
                  <div class="mod-card-meta">
                    <span>
                      <svg class="ui-icon ui-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                      <%= (rm.downloads_count || 0).toLocaleString('ru-RU') %>
                    </span>
                  </div>
                </div>
              </a>
            <% }); %>
          </div>
        </section>
      <% } %>
    </div>
  </div>

  <!-- RIGHT: Mod Info Sidebar -->
  <div class="mod-info-card" data-fade>
    <h3 style="font-size:1.2rem; margin-bottom:16px; display:flex; align-items:center; gap:8px;">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="20" x2="18" y2="10"></line>
        <line x1="12" y1="20" x2="12" y2="4"></line>
        <line x1="6" y1="20" x2="6" y2="14"></line>
      </svg>
      <span>Информация</span>
    </h3>

    <div class="mod-info-row">
      <span class="mod-info-label">Игра</span>
      <span class="mod-info-value"><%= mod.game_title %></span>
    </div>
    <div class="mod-info-row">
      <span class="mod-info-label">Версия</span>
      <span class="mod-info-value"><%= mod.game_version %></span>
    </div>
    <% if (mod.cat_name) { %>
    <div class="mod-info-row">
      <span class="mod-info-label">Категория</span>
      <span class="mod-info-value"><%= mod.cat_name %></span>
    </div>
    <% } %>
    <div class="mod-info-row">
      <span class="mod-info-label">Размер</span>
      <span class="mod-info-value"><%= mod.file_size_mb %> МБ</span>
    </div>
    <div class="mod-info-row">
      <span class="mod-info-label">Загрузки</span>
      <span class="mod-info-value"><%= (mod.downloads_count || 0).toLocaleString('ru-RU') %></span>
    </div>

    <div style="margin-top:24px; display:flex; flex-direction:column; gap:10px;">
      <form action="/modpack/add/<%= mod.id %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-primary btn-block">
          <svg class="ui-icon ui-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Добавить в сборку</span>
        </button>
      </form>
      <% if (mod.source_url) { %>
        <a href="<%= mod.source_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-block">
          <svg class="ui-icon ui-icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          <span>Источник</span>
        </a>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
