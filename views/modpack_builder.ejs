<%- include('partials/header') %>

<h1 class="page-title">Конструктор сборок</h1>
<p class="page-subtitle">Собирай свой идеальный модпак и сохраняй в один клик</p>

<div class="builder-layout">
  <% if (typeof cartMods !== 'undefined' && cartMods.length > 0) { %>
    <%
      var totalSize = 0;
      cartMods.forEach(function(m) { totalSize += (m.file_size_mb || 0); });
    %>

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
      <div style="color:var(--text-muted); font-size:14px; display:flex; align-items:center; gap:8px;">
        <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
        </svg>
        <span>
          <strong><%= cartMods.length %></strong> модов в сборке &bull; Общий размер: <strong><%= totalSize.toFixed(1) %> МБ</strong>
        </span>
      </div>
    </div>

    <div class="builder-list">
      <% cartMods.forEach(function(mod, i) { %>
        <div class="builder-item" data-fade>
          <div class="builder-item-num"><%= i + 1 %></div>
          <div class="builder-item-info">
            <div class="builder-item-title">
              <a href="/mods/<%= mod.id %>" style="color:var(--text-main); text-decoration:none;">
                <%= mod.title %>
              </a>
            </div>
            <div class="builder-item-meta">
              <span><%= mod.game_title %></span>
              <% if (mod.game_version) { %> &bull; <span>v<%= mod.game_version %></span><% } %>
              &bull; <span><%= mod.file_size_mb %> МБ</span>
            </div>
          </div>
          <div style="display:flex; align-items:center; gap:10px; flex-shrink:0;">
            <span class="badge badge-game"><%= mod.game_title %></span>
            <form action="/modpack/remove/<%= mod.id %>" method="POST" style="margin:0;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-danger btn-sm" title="Убрать из сборки">Убрать</button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="card" style="padding:28px; margin-top:28px;" data-fade>
      <h3 style="font-size:1.2rem; margin-bottom:20px;">Параметры сборки</h3>
      <form action="/modpack/checkout" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid-2">
          <div class="form-group">
            <label class="form-label" for="target_game_version">Целевая версия игры</label>
            <input type="text" id="target_game_version" name="target_game_version" class="form-input" placeholder="Например: 1.21.4 или Latest" value="<%= cartMods[0] && cartMods[0].game_version ? cartMods[0].game_version : 'Latest' %>">
          </div>
          <div class="form-group">
            <label class="form-label" for="install_method">Способ установки</label>
            <select id="install_method" name="install_method" class="form-select">
              <option value="Manual">Вручную (Manual)</option>
              <option value="Mod Organizer 2">Mod Organizer 2</option>
              <option value="Vortex">Vortex</option>
              <option value="Modrinth / CurseForge">Modrinth / CurseForge</option>
              <option value="tModLoader">tModLoader / Steam Workshop</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label" for="notes">Заметки к сборке (опционально)</label>
          <textarea id="notes" name="notes" class="form-textarea" style="min-height:84px;" placeholder="Порядок загрузки, конфликты или пометки для себя..."></textarea>
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center;">
          <button type="submit" class="btn btn-primary btn-lg btn-pill">
            <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span>Сохранить сборку</span>
          </button>
          <a href="/catalog" class="btn btn-outline btn-lg btn-pill">
            <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Добавить ещё</span>
          </a>
        </div>
      </form>
    </div>

  <% } else { %>
    <!-- 4. ОФОРМЛЕННЫЙ EMPTY STATE МОДПАКА -->
    <div class="empty-state" data-fade>
      <div class="empty-state-icon">
        <svg class="ui-icon-lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
          <line x1="12" y1="22.08" x2="12" y2="12"></line>
        </svg>
      </div>
      <h2 class="empty-state-title">Твой модпак пока пуст</h2>
      <p class="empty-state-desc">Добавляй понравившиеся моды из каталога в один клик, чтобы скомпоновать готовую сборку.</p>
      <a href="/catalog" class="btn btn-primary btn-pill">Выбрать моды в каталоге</a>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
