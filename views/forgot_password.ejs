<%- include('partials/header') %>

<%
  var curStep = typeof step !== 'undefined' ? step : 'request';
  var emailVal = typeof email !== 'undefined' ? email : '';
%>

<div class="auth-wrap">
  <div class="auth-card" data-fade>
    <h1 class="auth-title" style="display:flex; align-items:center; justify-content:center; gap:10px;">
      <svg class="ui-icon" style="width:24px; height:24px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>Сброс пароля</span>
    </h1>
    <p class="auth-subtitle">
      <% if (curStep === 'verify') { %>
        Введите 6-значный код с почты <strong><%= emailVal %></strong> и задайте новый пароль
      <% } else { %>
        Укажите почту аккаунта — мы отправим 6-значный код восстановления
      <% } %>
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:rgba(255,23,68,0.12); border:1px solid rgba(255,23,68,0.3); border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:20px; color:var(--danger); font-size:14px;">
        <%= error %>
      </div>
    <% } %>

    <% if (typeof info !== 'undefined' && info) { %>
      <div style="background:rgba(56,189,248,0.12); border:1px solid rgba(56,189,248,0.35); border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:20px; color:var(--accent-primary); font-size:14px;">
        <%= info %>
      </div>
    <% } %>

    <% if (typeof devCode !== 'undefined' && devCode) { %>
      <div style="background:rgba(255,171,0,0.12); border:1px solid rgba(255,171,0,0.4); border-radius:var(--radius-sm); padding:12px 16px; margin-bottom:20px; color:var(--warning); font-size:13.5px;">
        <strong>Тестовый режим (SMTP пока не настроен):</strong><br>
        Код восстановления: <code style="font-size:16px; font-weight:800; letter-spacing:3px; color:var(--text-main);"><%= devCode %></code>
      </div>
    <% } %>

    <% if (curStep === 'verify') { %>
      <form action="/forgot-password/verify" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="email" value="<%= emailVal %>">

        <div class="form-group">
          <label class="form-label" for="code">6-значный код из письма</label>
          <input type="text" id="code" name="code" class="form-input" placeholder="000000" required maxlength="6" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" style="text-align:center; font-size:22px; letter-spacing:8px; font-weight:700;">
        </div>

        <div class="form-group">
          <label class="form-label" for="new_password">Новый пароль (от 6 символов)</label>
          <input type="password" id="new_password" name="new_password" class="form-input" placeholder="••••••••" required minlength="6" autocomplete="new-password">
        </div>

        <div class="form-group">
          <label class="form-label" for="confirm_password">Повторите новый пароль</label>
          <input type="password" id="confirm_password" name="confirm_password" class="form-input" placeholder="••••••••" required minlength="6" autocomplete="new-password">
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">Обновить пароль</button>
      </form>

      <div style="margin-top:16px; text-align:center;">
        <a href="/forgot-password" class="btn btn-ghost btn-sm">Запросить код заново</a>
      </div>
    <% } else { %>
      <form action="/forgot-password" method="POST" data-validate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-group">
          <label class="form-label" for="email">Email аккаунта</label>
          <input type="email" id="email" name="email" class="form-input" placeholder="user@example.com" value="<%= emailVal %>" required autocomplete="email">
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg">Отправить код восстановления</button>
      </form>
    <% } %>

    <div class="auth-divider">вспомнили пароль?</div>
    <a href="/login" class="btn btn-secondary btn-block">Вернуться к входу</a>
  </div>
</div>

<%- include('partials/footer') %>
