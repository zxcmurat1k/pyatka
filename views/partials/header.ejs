<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof appName !== 'undefined' ? appName : 'HornyHo' %> — Каталог игровых модов и конструктор сборок">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %><%= typeof appName !== 'undefined' ? appName : 'HornyHo' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body<% if (typeof mod !== 'undefined' && mod && mod.is_nsfw === 1) { %> data-mod-nsfw="1"<% } %>>
  <a href="#main" class="skip-link">Перейти к контенту</a>

  <!-- HEADER -->
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">
        <span class="logo-icon">🔥</span>
        <span><%= typeof appName !== 'undefined' ? appName : 'HornyHo' %></span>
      </a>

      <nav class="nav-main" id="navMain" aria-label="Основная навигация">
        <a href="/" class="<%= typeof currentPage !== 'undefined' && currentPage === 'index' ? 'active' : '' %>">Главная</a>
        <a href="/catalog" class="<%= typeof currentPage !== 'undefined' && currentPage === 'catalog' ? 'active' : '' %>">Каталог</a>
        <a href="/modpack" class="cart-link <%= typeof currentPage !== 'undefined' && currentPage === 'builder' ? 'active' : '' %>">
          Сборки
          <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
            <span class="cart-badge"><%= cartCount %></span>
          <% } %>
        </a>
        <a href="/contacts" class="<%= typeof currentPage !== 'undefined' && currentPage === 'contacts' ? 'active' : '' %>">Контакты</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/profile" class="<%= typeof currentPage !== 'undefined' && currentPage === 'profile' ? 'active' : '' %>">Профиль</a>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="<%= typeof currentPage !== 'undefined' && currentPage === 'admin' ? 'active' : '' %>">Админ</a>
          <% } %>
          <a href="/logout">Выйти</a>
        <% } else { %>
          <a href="/login" class="<%= typeof currentPage !== 'undefined' && currentPage === 'login' ? 'active' : '' %>">Войти</a>
        <% } %>
      </nav>

      <div class="header-actions">
        <button class="theme-toggle" id="themeToggle" aria-label="Переключить тему">
          <span class="icon-sun">☀️</span>
          <span class="icon-moon">🌙</span>
        </button>
        <button class="menu-toggle" id="menuToggle" aria-label="Меню">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT START -->
  <main id="main" class="main-content">
    <div class="container">
