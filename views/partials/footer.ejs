    </div><!-- /.container -->
  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="footer-inner">
      <span class="footer-copy">© 2026 <%= typeof appName !== 'undefined' ? appName : 'HornyHo' %>. Все права защищены.</span>
      <div class="footer-links">
        <a href="/about">О проекте</a>
        <a href="/faq">FAQ</a>
        <a href="/privacy">Политика конфиденциальности</a>
        <a href="/contacts">Контакты</a>
      </div>
    </div>
  </footer>

  <!-- SCROLL TO TOP -->
  <button class="scroll-top" id="scrollTop" aria-label="Наверх">
    <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  <!-- AGE GATE MODAL -->
  <div class="age-modal-overlay" id="ageModal">
    <div class="age-modal" role="dialog" aria-modal="true" aria-labelledby="ageTitle" aria-describedby="ageDesc">
      <div class="age-modal-icon">
        <svg class="ui-icon" style="width:52px;height:52px;color:var(--accent-nsfw);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="8" y1="9" x2="8" y2="15"></line>
          <path d="M13.5 10a1.5 1.5 0 0 1 0 3 1.5 1.5 0 0 1 0 3"></path>
          <path d="M18 11v4"></path>
          <path d="M16 13h4"></path>
        </svg>
      </div>
      <h2 class="age-modal-title" id="ageTitle">Подтверждение возраста (18+)</h2>
      <p class="age-modal-text" id="ageDesc">
        Вы переходите в закрытый раздел модификаций для взрослых. Вам уже исполнилось 18 лет?
      </p>
      <div class="age-modal-btns">
        <button type="button" class="btn btn-nsfw btn-lg" onclick="confirmAge()">Да, мне есть 18+</button>
        <button type="button" class="btn btn-secondary btn-lg" onclick="denyAge()">Нет, вернуться</button>
      </div>
    </div>
  </div>

    <!-- TOP PROGRESS BAR -->
  <div class="net-progress-bar" id="netProgressBar" aria-hidden="true"></div>

  <!-- OFFLINE / ONLINE STATUS BANNER -->
  <div class="net-offline-banner" id="netOfflineBanner" role="status" aria-live="polite" hidden>
    <div class="net-offline-inner">
      <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="1" y1="1" x2="23" y2="23"></line>
        <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
        <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
        <path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path>
        <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
        <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
        <line x1="12" y1="20" x2="12.01" y2="20"></line>
      </svg>
      <span id="netOfflineText">Нет подключения к сети. Страницы и изображения могут не загружаться.</span>
      <button type="button" class="btn btn-sm btn-secondary" onclick="window.location.reload()">Обновить</button>
    </div>
  </div>

  <!-- SLOW-NETWORK PER-TAB SKELETON OVERLAY -->
  <div class="page-skeleton-overlay" id="pageSkeletonOverlay" aria-hidden="true">
    <div class="page-skeleton-shell">
      <div class="page-skeleton-topbar">
        <div class="page-skeleton-status">
          <span class="skel-spinner"></span>
          <span id="skelStatusLabel">Загружаем раздел...</span>
        </div>
        <div class="page-skeleton-actions">
          <button type="button" class="btn btn-ghost btn-sm" id="skelCancelBtn">Скрыть</button>
          <button type="button" class="btn btn-primary btn-sm" id="skelRetryBtn">Повторить</button>
        </div>
      </div>
      <div class="page-skeleton-body" id="pageSkeletonBody"></div>
    </div>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>
