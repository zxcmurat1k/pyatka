# === SMTP-НАСТРОЙКИ ДЛЯ ОТПРАВКИ 6-ЗНАЧНЫХ КОДОВ (HornyHo) ===
# Скопируй в .env и заполни после создания почты, затем: pm2 restart hornyho --update-env
#
# Вариант 1 — Яндекс.Почта (пароль приложения: id.yandex.ru -> Безопасность -> Пароли приложений):
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_name@yandex.ru
# SMTP_PASS=your_app_password
#
# Вариант 2 — Mail.ru (пароль для внешнего приложения: account.mail.ru -> Безопасность):
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_name@mail.ru
# SMTP_PASS=your_app_password

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HornyHo <no-reply@hornyho.local>"

# Пока SMTP не заполнен, показывать тестовый код прямо в форме (выключится автоматически при заполнении SMTP)
MAIL_DEV_PREVIEW=true
